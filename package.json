{
  "name": "rule1",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "pnpm --filter @rule1/web build",
    "check": "biome check .",
    "test": "node --test scripts/validate-sources.test.mjs && pnpm --filter @rule1/web test",
    "validate:sources": "node scripts/validate-sources.mjs",
    "typecheck": "pnpm --filter @rule1/web typecheck",
    "verify": "pnpm check && pnpm typecheck && pnpm test && pnpm build && node scripts/verify-static.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@types/node": "22.15.3",
    "typescript": "5.9.3"
  }
}
